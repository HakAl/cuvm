# tinyproxy config for one cuvm run. Rendered by replacing @GATEWAY@, @GUEST@,
# @ALLOWFILE@ and @LOGFILE@ with absolute values. Directive names confirmed
# against tinyproxy.conf(5) for 1.11.3 on 2026-10-25.

User nobody
Group nobody

# Bind only the vmnet gateway address, after the VM has brought bridge100 up.
Listen @GATEWAY@
Port 8888
Timeout 60

# Access control: only the one guest may use the proxy.
Allow @GUEST@

# Domain allowlist: everything not listed is denied.
Filter "@ALLOWFILE@"
FilterType fnmatch
FilterDefaultDeny Yes
FilterURLs Off
FilterCaseSensitive Off

# CONNECT only to 443. No plain-HTTP tunnelling to arbitrary ports.
ConnectPort 443

# Log every connection attempt, allowed or denied, into the run record.
LogFile "@LOGFILE@"
LogLevel Connect
PidFile "@LOGFILE@.pid"

# Do not reveal the host to upstreams.
DisableViaHeader Yes
XTinyproxy No
